# Copy to .env.local (or set with `vercel env add`). Never commit real keys.
# AI is optional: without any key /api/explain and /api/generate answer 503 and the lesson works offline.

# Alem API (used first when set). One OpenAI-compatible endpoint.
ALEM_API_KEY=
ALEM_MODEL=alemllm
ALEM_FALLBACK_MODEL=gpt-oss
# Only if the fallback model needs its own key:
ALEM_FALLBACK_API_KEY=
ALEM_BASE_URL=https://llm.alem.ai/v1

# Anthropic Claude (used when Alem is not configured or fails).
ANTHROPIC_API_KEY=
